{
  "name": "sveawebpay/nwt-magento2-checkout",
  "description": "Svea Checkout",
  "type": "magento2-module",
  "version": "1.7.0",
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Svea\\Checkout\\": ""
    }
  },
  "require": {
    "php": ">=8.1",
    "ext-mbstring": "*"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://repo.magento.com/"
    }
  ],
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
